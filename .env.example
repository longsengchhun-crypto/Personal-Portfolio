NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_DASHBOARD_TOKEN=generate-a-long-random-token
ADMIN_USERNAME=Admin12345
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=generate-a-different-long-random-secret

# Recommended email provider
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=LONG SENGCHHUN <hello@your-verified-domain.com>
EMAIL_REPLY_TO=longsengchhun@gmail.com

# Optional SMTP email fallback
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email-user
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=longsengchhun@gmail.com

# SMS provider (use either a From number or a Messaging Service SID)
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+12025550123
TWILIO_MESSAGING_SERVICE_SID=
ENABLE_SMS_NOTIFICATIONS=false
